#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}
if ! command -v brew >/dev/null 2>&1; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [ -f "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

echo "Installing macOS packages via Brewfile..."
brew bundle --file="{{ .chezmoi.sourceDir }}/dot_Brewfile" --no-lock || true

{{ else if eq .chezmoi.os "linux" -}}
if command -v apt-get >/dev/null 2>&1; then
    echo "Installing base packages on Linux/gLinux via apt..."
    PACKAGES="git zsh curl build-essential ca-certificates unzip jq pkg-config libreadline-dev libncurses-dev libssl-dev zlib1g-dev pipx"
    if command -v sudo >/dev/null 2>&1; then
        sudo apt-get update -y || true
        sudo apt-get install -y $PACKAGES || true
    else
        apt-get update -y || true
        apt-get install -y $PACKAGES || true
    fi
fi
{{ end -}}
