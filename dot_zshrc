# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# PATH setup
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$HOME/go/bin:$HOME/.gemini/bin:$PATH"
export ZSH="$HOME/.oh-my-zsh"

# Set theme (managed via .chezmoiexternal.toml in ~/.oh-my-zsh/custom/themes/)
ZSH_THEME="powerlevel10k/powerlevel10k"

# Oh my zsh configuration
ENABLE_CORRECTION="true"

# Oh my zsh plugins
# Custom plugins (zsh-autosuggestions, zsh-syntax-highlighting, zsh-vi-mode) are managed in ~/.oh-my-zsh/custom/plugins
plugins=(
  git
  gitfast
  docker
  pip
  poetry
  python
  zsh-vi-mode
  mise
  direnv
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# Editor configuration
export EDITOR="nvim"
export VISUAL="nvim"

# zsh-vi-mode upgrade
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd v edit-command-line

# Automatically activate venv virtual environment
export PYTHON_AUTO_VRUN=true

# Source Oh My Zsh
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# Sourcing custom aliases and commands if present
[[ -f "$HOME/.zsh/aliases.zsh" ]] && source "$HOME/.zsh/aliases.zsh"
[[ -f "$HOME/.zsh/commands.zsh" ]] && source "$HOME/.zsh/commands.zsh"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f "$HOME/.p10k.zsh" ]] || source "$HOME/.p10k.zsh"

# Activate mise (manages node, python, go, neovim, ripgrep, fd, etc.)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
